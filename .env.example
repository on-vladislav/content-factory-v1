# Local Docker Compose: choose your own values before starting.
# Use only ASCII letters and digits in the database password (it is used in a URL).
CONTENT_FACTORY_DB_PASSWORD=
CONTENT_FACTORY_WORKER_TOKEN=

# Telegram publisher: export these in the publisher process environment.
# This file is not loaded automatically by the Python scripts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n workflow environment: set these on your own n8n instance if its workflows use them.
# Notion and Telegram API credentials are configured separately in n8n Credentials.
NOTION_RADAR_DATABASE_ID=
NOTION_RADAR_DATA_SOURCE_ID=
TELEGRAM_INTAKE_CHAT_ID=
CONTENT_FACTORY_ROOT=

