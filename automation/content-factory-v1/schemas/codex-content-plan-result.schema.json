{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onishchukvlad.ru/schemas/content-factory/codex-content-plan-result-v1.json",
  "title": "Content Factory Codex Content Plan Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "job_id", "revision", "status", "manual_lock", "period", "timezone", "goal", "primary_channel", "sources", "items", "review"],
  "properties": {
    "schema_version": {"type": "string", "const": "content-factory/content-plan-v1"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,79}$"},
    "job_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{5,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "const": "REVIEW"},
    "manual_lock": {"type": "boolean", "const": false},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "timezone": {"type": "string", "const": "Europe/Moscow"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
    "primary_channel": {"type": "string", "const": "telegram"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "supporting"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "supporting": {"type": "array", "items": {"type": "string"}, "maxItems": 20}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "planned_at", "topic", "description", "audience", "problem", "main_idea", "source_reference", "format", "cta", "channel", "status"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,79}$"},
          "planned_at": {"type": "string", "minLength": 20, "maxLength": 40},
          "topic": {"type": "string", "minLength": 1, "maxLength": 200},
          "description": {"type": "string", "minLength": 1, "maxLength": 800},
          "audience": {"type": "string", "minLength": 1, "maxLength": 500},
          "problem": {"type": "string", "minLength": 1, "maxLength": 500},
          "main_idea": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_reference": {"type": "string", "minLength": 1, "maxLength": 500},
          "format": {"type": "string", "minLength": 1, "maxLength": 100},
          "cta": {"type": "string", "maxLength": 500},
          "channel": {"type": "string", "const": "telegram"},
          "status": {"type": "string", "const": "DRAFT"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needs_clarification", "clarification_questions", "warnings"],
      "properties": {
        "needs_clarification": {"type": "boolean"},
        "clarification_questions": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
        "warnings": {"type": "array", "items": {"type": "string"}, "maxItems": 20}
      }
    }
  }
}
