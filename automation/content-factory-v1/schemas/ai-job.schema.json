{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onishchukvlad.ru/schemas/content-factory/ai-job-v1.json",
  "title": "Content Factory AI Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "type", "status", "attempt", "max_attempts", "lease_token", "payload"],
  "properties": {
    "schema_version": {"type": "string", "const": "content-factory/ai-job-v1"},
    "job_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{5,63}$"},
    "type": {"type": "string", "pattern": "^(GENERATE_POST|REVISE_POST)$"},
    "status": {"type": "string", "const": "CLAIMED"},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "lease_token": {"type": "string", "minLength": 16, "maxLength": 256},
    "lease_expires_at": {"type": "string"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "sources", "editorial_brief", "platforms", "additional_instruction", "correction_comment", "current_post_json"],
      "properties": {
        "post_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,79}$"},
        "revision": {"type": "integer", "minimum": 1},
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "supporting"],
          "properties": {
            "primary": {"type": "string", "minLength": 1},
            "supporting": {"type": "array", "items": {"type": "string"}, "maxItems": 20}
          }
        },
        "editorial_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audience", "problem", "main_idea", "goal", "cta", "facts", "limitations"],
          "properties": {
            "audience": {"type": "string", "minLength": 1},
            "problem": {"type": "string", "minLength": 1},
            "main_idea": {"type": "string", "minLength": 1},
            "goal": {"type": "string", "minLength": 1},
            "cta": {"type": "string"},
            "facts": {"type": "array", "items": {"type": "string"}},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        },
        "platforms": {
          "type": "array",
          "items": {"type": "string"},
          "const": ["telegram"]
        },
        "additional_instruction": {"type": "string", "maxLength": 4000},
        "correction_comment": {"type": "string", "maxLength": 4000},
        "current_post_json": {"type": "string", "maxLength": 100000}
      }
    }
  }
}
